    "name": "Cervezas API - Mejorada",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección de pruebas para la API de cervezas con captura dinámica de IDs"
  },
  "item": [
    {
      "name": "Obtener todas las cervezas",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/beers",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["beers"]
        }
      }
    },
    {
      "name": "Añadir una cerveza",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('beer_id', jsonData.id);",
              "    console.log('Beer ID capturado: ' + jsonData.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"IPA Test\",\n  \"abv\": 6.5,\n  \"ibu\": 60,\n  \"srm\": 12,\n  \"ebc\": 24,\n  \"style_id\": 2,\n  \"brewery_id\": 1,\n  \"category_id\": 1,\n  \"description\": \"India Pale Ale aromática de prueba.\"\n}"
        },
        "url": {
          "raw": "http://localhost:8080/beer",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["beer"]
        }
      }
    },
    {
      "name": "Obtener una cerveza por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8080/beer/{{beer_id}}",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["beer", "{{beer_id}}"]
        }
      }
    },
    {
