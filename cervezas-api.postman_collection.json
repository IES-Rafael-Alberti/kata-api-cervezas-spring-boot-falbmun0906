          "mode": "raw",
          "raw": "{\n  \"name\": \"IPA Actualizada\",\n  \"abv\": 7.0,\n  \"ibu\": 65,\n  \"srm\": 13,\n  \"ebc\": 26,\n  \"style_id\": 2,\n  \"brewery_id\": 1,\n  \"category_id\": 1,\n  \"description\": \"IPA actualizada con mayor amargor.\"\n}"
